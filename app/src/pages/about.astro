---
import Layout from '~/layouts/Layout.astro'
import Header from '~/components/Header.astro'
import ContentSection from '~/components/ContentSection.astro'
import Button from "~/components/Button.astro"
import StaffCard from '~/components/StaffCard.astro'
import AboutTimeline from '~/components/AboutTimeline.astro'
import Footer from '~/components/Footer.astro'
import getStaff from '~/data/about/staff'
import donate from '~/data/donate.json'
import ligneDeVie from '~/assets/ligneDeVie.png'

const staff = await getStaff()
const founders = staff.filter(({ group }) => group !== 'volunteer')
const volunteers = staff.filter(({ group }) => group === 'volunteer')
---

<Layout
	title="Les Fondateurs"
	lang="fr"
	description="Découvrez l'équipe et les bénévoles derrière 2GETHER, ainsi que l'histoire de l'association depuis sa création."
	htmlClass="h-full motion-safe:scroll-smooth"
	htmlAttributes={{ "data-theme": "dark" }}
	bodyClass="h-full overflow-x-hidden bg-background text-text text-base selection:bg-secondary selection:text-white"
	socialUrl={Astro.site}
	socialImage={new URL('/assets/logo.png', Astro.site)}
>
	<Header />
	<div class="grid place-items-center py-16">
		<ContentSection title="Qui sommes nous ?" id="nous" class="row">
			<div class="flex flex-row flex-wrap items-stretch justify-center mx-5 gap-5">
				{
					founders.map(staffMember => (
						<StaffCard {...staffMember} />
					))
				}
			</div>

			{volunteers.length > 0 && (
				<>
					<h3 class="text-xl font-extrabold text-theme-900">Nos Bénévoles</h3>
					<div class="flex flex-row flex-wrap items-stretch justify-center mx-5 gap-5">
						{
							volunteers.map(staffMember => (
								<StaffCard {...staffMember} />
							))
						}
					</div>
				</>
			)}
			<div class="grid-cols-3 text-center">
				<Button href="https://files.2gether-asso.fr/asso/statuts.pdf">Les Statuts</Button>
				<Button href="https://files.2gether-asso.fr/asso/règlement_intérieur.pdf">Règlement Intérieur</Button>
				<Button href="/legal">Mentions légales</Button>
				<Button href="https://files.2gether-asso.fr/asso/bureau.pdf">Le Bureau</Button>
				{donate.url && (
					<Button href={donate.url}>Faire un don ♥</Button>
				)}
			</div>
		</ContentSection>
		<img src={ligneDeVie.src} class="center" />
		<AboutTimeline />
	</div>
	<Footer />
	<style lang="scss">
		/* Remove extra left and right margins, due to padding in columns */
		.row {
			align-items: center;
			margin: auto;
			justify-items: center;
		}

		/* Clear floats after the columns */
		.row:after {
			content: "";
			display: table;
			clear: both;
		}

		.center {
			display: block;
			margin-left: auto;
			margin-right: auto;
		}
	</style>
</Layout>
