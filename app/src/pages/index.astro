---
import Layout from '~/layouts/Layout.astro'
import Header from '~/components/Header.astro'
import Splash from '~/components/Splash.astro'
import HomeIntro from '~/components/HomeIntro.astro'
import Activities from '~/components/Activities.astro'
import Footer from '~/components/Footer.astro'
import '~/styles/index.css'
---

<Layout
	title="Bienvenue sur 2GETHER"
	lang="fr"
	description="2GETHER est une association loi 1901 qui rassemble et aide les jeunes à sortir de l'isolement social, à travers des activités en physique et à distance."
	htmlAttributes={{ "data-theme": "dark" }}
	socialUrl={Astro.site}
	socialImage={new URL('/assets/logo.png', Astro.site)}
>
	<Header fixedHeader={false} />
	<Splash />
	<main>
		<HomeIntro />
		<Activities />
	</main>
	<Footer />
</Layout>

<style lang="scss">
@reference "#tailwind.css";

	main {
		@apply px-5 py-24 space-y-24;
	}
</style>
