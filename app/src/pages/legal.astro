---
import Layout from '~/layouts/Layout.astro'
import Header from '~/components/Header.astro'
import PageTitle from '~/components/PageTitle.astro'
import Footer from '~/components/Footer.astro'
import ligneDeVie from '~/assets/ligneDeVie.png'
import logoUrl from '~/assets/logo.png?url'
---

<Layout
	title="Mentions légales"
	lang="fr"
	description="Mentions légales du site internet 2gether-asso.fr."
	htmlClass="h-full motion-safe:scroll-smooth"
	htmlAttributes={{ "data-theme": "dark" }}
	bodyClass="h-full overflow-x-hidden bg-background text-text text-base selection:bg-secondary selection:text-white"
	socialUrl={Astro.site}
	socialImage={logoUrl}
>
	<Header />
	<main class="grow py-16">
		<PageTitle id="legal" class="mb-4">Mentions légales</PageTitle>
		<p class="text-center mx-5">
			Les présentes mentions légales concernent le site internet 2gether-asso.fr (le «&nbsp;Site&nbsp;»).
		</p>
		<img src={ligneDeVie.src} class="center mb-4" />

		<div class="grid grid-cols-1 grid- sm:grid-cols-2 max-w-7xl mx-auto gap-5 px-5 mb-5">
			<div class="p-6 max-w-7xl bg-theme-100 rounded-lg border border-theme-200 shadow-md sm:col-span-2">
				<h3 class="text-lg font-extrabold mb-2">
					Association 2GETHER
				</h3>
				<p>
					2GETHER est une association loi 1901 déclarée au Journal Officiel le 30 décembre 2020. <br />
					Adresse du siège social : 18 allée des Sophoras, 34070 Montpellier. <br />
					Numéro RNA : {' '}
					<a href="https://www.journal-officiel.gouv.fr/pages/associations-detail-annonce/?q.id=id:202100010265" class="text-primary">
						W343028588
					</a>.
				</p>
			</div>
			<div class="p-6 max-w-7xl bg-theme-100 rounded-lg border border-theme-200 shadow-md sm:row-span-2">
		<!-- <div class="flex flex-row sm:flex-col max-w-7xl mx-auto gap-5 mb-5">
			<div class="w-1/2 mx-5 p-6 max-w-7xl bg-theme-100 rounded-lg border border-theme-200 shadow-md"> -->
				<h3 class="text-lg font-extrabold mb-2">
					Éditeur du Site
				</h3>
				<p>
					La fonction de <u>Directeur de la publication</u> du Site est
					assumée par une personne physique de nationalité française&nbsp;: {' '}
					<b>Quentin Helayel</b> (Helldwin).
				</p>
				<br />
				<p>
					Des informations pour contacter cette personne sont
					disponibles sur son site internet&nbsp;: {' '}
					<a href="https://quentin-helayel.me" class="text-primary">
						quentin-helayel.me
					</a>
				</p>
				<img src={ligneDeVie.src} class="center" />
				<p>
					La fonction de <u>Développeur en chef</u> du Site est
					assumée par une personne physique de nationalité française&nbsp;: {' '}
					<b>Mathieu Guérin</b> (Matiboux).
				</p>
				<br />
				<p>
					Des informations pour contacter cette personne sont
					disponibles sur son site internet&nbsp;: {' '}
					<a href="https://matiboux.me" class="text-primary">
						matiboux.me
					</a>
				</p>
			</div>
			<div
				class="p-6 max-w-7xl bg-theme-100 rounded-lg border border-theme-200 shadow-md grow"
			>
				<h3 class="text-lg font-extrabold mb-2">
					Hébergeur du Site
				</h3>
				<p>
					Le Site est hébergé par <b>Github</b>, via son
					service Github Pages.
				</p>
				<br />
				<p>
					88 Colin P Kelly Jr St <br />
					San Francisco, CA 94107, United States <br />
					<a href="https://pages.github.com" class="text-primary">
						pages.github.com
					</a>
				</p>
			</div>
			<div class="license-card p-6 max-w-7xl bg-theme-100 rounded-lg border border-theme-200 shadow-md">
				<h3 class="text-lg font-extrabold mb-2">
					Licence
					<img
						src="https://mirrors.creativecommons.org/presskit/buttons/80x15/svg/by-nc-sa.svg"
						alt="CC BY-NC-SA 4.0"
						class="inline ml-2 mb-1 h-5"
					/>
				</h3>
				<p>
					Le contenu de ce site est distribué sous licence Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International.
				</p>
				<p>
					<span class="icon icon-[mdi--copyright] icon-align icon-fw"></span>
					2020-2026 – 2GETHER
				</p>
				<p>
					<a href="https://github.com/2gether-asso/2gether-asso.fr" class="text-primary">Voir le code source sur Github</a>
				</p>
			</div>
		</div>
	</main>
	<style>
		.center {
			display: block;
			margin-left: auto;
			margin-right: auto;
		}
	</style>
	<Footer />
</Layout>

<style lang="scss">
@reference "#tailwind.css";

.license-card {
	.icon {
		@apply h-5 inline mb-0.5;
	}
}
</style>
