---
import ContentSection from '~/components/ContentSection.astro'

import logoUrl from '~/assets/logo.png?url'

interface Props
{
	class?: string
}

const {
	class: className = '',
} = Astro.props
---

<ContentSection id="intro" class={className} title="Une association à but non lucratif">
	<Fragment slot="eyebrow">
		<img src={logoUrl} class="logo" />
		<span class="sr-only">2GETHER</span>

		<style lang="scss">
			@reference "#tailwind.css";

			.logo {
				@apply max-w-4xl w-full;
				@apply pointer-events-none select-none;
			}
		</style>
	</Fragment>

	<Fragment slot="lead">
		Régie par la loi 1901, notre but est de <span class="text-primary">rassembler</span>
		et <span class="text-primary">d'aider</span> les jeunes à sortir de l'isolement social.
	</Fragment>
</ContentSection>
