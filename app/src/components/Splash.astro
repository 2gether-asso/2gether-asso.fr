---
import Sky from '~/components/Sky.astro'
import Parallax from '~/components/Parallax.astro'
import Starfield from '~/components/Starfield.astro'
import Button from './Button.astro'
import social from '~/data/social.json'
import logoUrl from '~/assets/logo.png?url'
---

<section class="relative h-full bg-black shrink-0 overflow-hidden">
	<Sky class="sky" />
	<Starfield />
	<div class="hero-content relative grid h-full place-items-center z-10">
		<div class="flex flex-col gap-3 self-end sm:gap-4 sm:self-auto">
			<!-- <h2 class="gradient-text text-center font-extrabold tracking-tighter text-4xl absolute">
				Partageons un moment
				<span class="sr-only">2GETHER</span>
			</h2> -->
			<h2 class="gradient-text text-center font-extrabold tracking-tighter text-4xl"
				data-text="Partageons un moment"
			>
				Partageons un moment
				<span class="sr-only">2GETHER</span>
			</h2>
			<img src={logoUrl} class="logotitre h-full w-auto max-h-20 text-white md:max-h-32" />
			<div class="btn relative grid h-full place-items-center">
				<Button href={social.discord.url}>
					<span class="icon icon-align icon-fw h-5 mr-2" class:list={[`icon-[${social.discord.icon.replaceAll(':', '--')}]`]}></span>
					Rejoins-nous sur Discord&nbsp;!
				</Button>
			</div>
		</div>
	</div>
	<Parallax />
</section>

<style lang="scss">
@reference "#tailwind.css";

section {
	@apply relative w-full h-screen pb-16;

	:global(.sky) {
		@apply pointer-events-none select-none;
		@apply absolute top-0 left-0 w-full h-full object-cover;
	}

	h2 {
		position: relative;

		&::before {
			content: attr(data-text);
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			color: transparent;
			text-shadow: 2px 2px 10px #0008;
			z-index: -1;
		}
	}

	img.logotitre {
		@apply pointer-events-none select-none;
		z-index: 49;
	}

	:global(.btn) > :global(*) > :global(*) {
		box-shadow: 2px 2px 5px 0 #0008;
	}

	.hero-content,
	:global(.btn) {
		@apply p-8;
	}
}
</style>
