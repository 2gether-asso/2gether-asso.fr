---
import ContentSection from '~/components/ContentSection.astro'

interface Props
{
	id: string
	class?: string
	title: string
}

const {
	id,
	class: className = '',
	title,
} = Astro.props
---

<ContentSection id={id} class={className} title={title}>
	<Fragment slot="lead">
		<slot name="lead" />
	</Fragment>

	<ul>
		<slot />
	</ul>
</ContentSection>

<style lang="scss">
@reference "#tailwind.css";

	@keyframes hc-bg-pan-GY7YG {
		from {
			background-position: 0% 0%;
		}
		to {
			background-position: 200vw 200vh;
		}
	}

	ul {
		animation: hc-bg-pan-GY7YG 3s linear infinite;
		@apply relative max-w-6xl;
		background: radial-gradient(var(--color-background-gradiant-top), var(--color-background-gradiant-bottom));
		background-size: 200vw 200vh;
		@apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3;
		gap: 1px;
		margin: 0;
		padding: 1px;
		overflow: hidden;

		@media (prefers-reduced-motion: reduce) {
			animation-play-state: paused;
		}

		> :global(li) {
			@apply relative;

			> :global(a[href]) {
				@apply cursor-pointer;
			}

			@media (min-width: theme("screens.md")) {
				&:nth-child(2n-1):nth-last-of-type(1) {
					grid-column: span 2;
				}
			}

			@media (min-width: theme("screens.lg")) {
				&:nth-child(2n-1):nth-last-of-type(1) {
					grid-column: inherit;
				}

				&:nth-child(3n-2):nth-last-of-type(1) {
					grid-column: span 3;
				}
				&:nth-child(3n-1):nth-last-of-type(1) {
					grid-column: span 2;
				}
			}

			transition: transform .3s ease-out, box-shadow .3s ease-out;

			&:hover,
			&:focus-within {
				@apply z-10;
				transform: translateY(-4px);
				box-shadow: 0 12px 24px -12px rgb(0 0 0 / 35%);
			}

			&:hover:before,
			&:focus-within:before {
				@apply bg-transparent;
			}

			&:before {
				@apply absolute w-full h-full bg-background;
				transition: background-color .5s ease-out;
				content: "";
			}

			> :global(div) {
				@apply p-6 backdrop-blur-sm;

				> :global(.icon) {
					@apply w-16 h-16 p-3 border-2 border-current rounded-full mx-auto mb-2;
					background-color: color-mix(in srgb, currentColor 10%, transparent);
					transition: transform .3s ease-out;
				}

				> :global(p) {
					transition: color .2s ease-in-out;
					@apply text-center;
				}

				> :global(.title) {
					@apply text-xl font-extrabold text-center mb-2;
				}

				> :global(.description) {
					@apply text-sm text-center text-text-offset;
				}
			}

			&:hover > :global(div > p),
			&:focus-within > :global(div > p) {
				@apply text-text;
			}

			&:hover > :global(div > .icon),
			&:focus-within > :global(div > .icon) {
				transform: scale(1.08);
			}
		}
	}

</style>
